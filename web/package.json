{
  "name": "mlkd-web",
  "version": "0.1.0",
  "description": "MLKD group portal — Next.js + Payload CMS",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "dissertations:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/import-dissertations.mjs",
    "dissertations:import:apply": "cross-env NODE_OPTIONS=--no-deprecation DISSERTATIONS_APPLY=1 payload run scripts/import-dissertations.mjs",
    "authors:link-aliases": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/link-author-aliases.mjs",
    "authors:link-aliases:apply": "cross-env AUTHOR_ALIASES_APPLY=1 NODE_OPTIONS=--no-deprecation payload run scripts/link-author-aliases.mjs",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "members:import": "node scripts/import-members.mjs --dry-run",
    "members:import:apply": "node scripts/import-members.mjs --apply",
    "members:import:db": "node scripts/import-members-db.mjs --apply",
    "members:import:offline": "node scripts/import-members.mjs --dry-run --offline",
    "publications:link-members": "node scripts/link-publication-members-db.mjs",
    "publications:link-members:apply": "node scripts/link-publication-members-db.mjs --apply",
    "scripts:test": "node --test scripts/tests/*.test.mjs",
    "publications:dedupe": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/merge-duplicate-publications.mjs",
    "publications:dedupe:apply": "cross-env PUBLICATIONS_DEDUPE_APPLY=1 NODE_OPTIONS=--no-deprecation payload run scripts/merge-duplicate-publications.mjs",
    "design:contrast": "node scripts/audit-contrast.mjs",
    "themes:sync": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/apply-research-themes.mjs",
    "themes:sync:apply": "cross-env THEMES_APPLY=1 NODE_OPTIONS=--no-deprecation payload run scripts/apply-research-themes.mjs",
    "seed:prune": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/prune-seed-fixtures.mjs",
    "seed:prune:apply": "cross-env SEED_PRUNE_APPLY=1 NODE_OPTIONS=--no-deprecation payload run scripts/prune-seed-fixtures.mjs",
    "members:phd": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/apply-phd-roster.mjs",
    "members:phd:apply": "cross-env PHD_ROSTER_APPLY=1 NODE_OPTIONS=--no-deprecation payload run scripts/apply-phd-roster.mjs",
    "members:status": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/apply-legacy-status.mjs",
    "members:status:apply": "cross-env LEGACY_STATUS_APPLY=1 NODE_OPTIONS=--no-deprecation payload run scripts/apply-legacy-status.mjs",
    "members:names": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/apply-roster-names.mjs",
    "members:names:apply": "cross-env ROSTER_NAMES_APPLY=1 NODE_OPTIONS=--no-deprecation payload run scripts/apply-roster-names.mjs",
    "events:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/import-events.mjs",
    "events:import:apply": "cross-env EVENTS_APPLY=1 NODE_OPTIONS=--no-deprecation payload run scripts/import-events.mjs",
    "photos:import": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/import-member-photos.mjs",
    "photos:import:apply": "cross-env MEMBER_PHOTOS_APPLY=1 NODE_OPTIONS=--no-deprecation payload run scripts/import-member-photos.mjs",
    "roster:reconcile": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/reconcile-roster.mjs",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "claude:map": "node ../scripts/gen-claude-map.mjs",
    "prepare": "node ../scripts/setup-hooks.mjs"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/storage-vercel-blob": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.2.6",
    "payload": "3.86.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "prettier": "^3.4.2",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": ">=20.9.0",
    "pnpm": "^9 || ^10"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
